DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
JWT_SECRET=ใส่สตริงสุ่มยาวๆ อย่างน้อย 32 ตัว (openssl rand -base64 32)
# Google OAuth (Google Cloud Console > Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
# URL ของเว็บ (ไม่มี / ท้าย) เช่น http://localhost:3000 หรือ https://ชื่อโปรเจกต์.vercel.app
APP_URL=http://localhost:3000
